body {
    background-color: #121212;
    color: white;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

h1, h2 {
    color: yellow;
    text-align: center;
}

h1 {
    font-size: 36px;
    font-weight: 700;
}

h2 {
    font-size: 26px;
    font-weight: 600;
}

h3 {
    font-size: 22px;
    color: yellow;
}

p {
    font-size: 18px;
    line-height: 1.5;
    color: #ddd;
}

a {
    color: yellow;
    text-decoration: none;
}

header {
    background-color: #2a2a2a;
}

.menu-table {
    margin: auto;
    font-size: 1.2rem;
    font-weight: bold;
    border-spacing: 30px; 
}

.cover {
    text-align: center;
}

.cover img {
    width: 100%;
    max-width: 1000px;
    margin: auto;
    border: 3px solid yellow;
}

.cover-caption {
    color: yellow;
    margin-top: 10px;
}

.description {
    background-color: #1e1e1e;
    padding: 30px 20px;
    text-align: center;
}

.description p {
    max-width: 800px;
    margin:auto;
}

.band {
    padding: 30px 20px;
    text-align: center;
}

.members {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 30px;
}

.member-card {
    background-color: #2a2a2a;
    width: 220px;
    padding: 15px 15px 20px;
    border: 2px solid #444;
}

.member-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 2px solid yellow;
}

.member-card h3 {
    font-size: 1.3rem;
    margin: 12px 0 5px;
}

.member-card p {
    color: #cccccc;
    margin: 0;
}

footer {
    background-color: #2a2a2a;
    text-align: center;
    padding: 20px 0;
    margin-top: 30px;
    border-top: 2px solid yellow;
}
